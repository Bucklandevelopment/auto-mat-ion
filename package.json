{
  "name": "auto-mat-ion",
  "version": "0.2.0",
  "description": "Framework opensource para granjas de pruebas distribuidas con dispositivos reales y gamificación científica",
  "type": "module",
  "bin": {
    "auto-mat-ion": "./dist/cli.js",
    "ami": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./execution": {
      "import": "./dist/execution/index.js",
      "types": "./dist/execution/index.d.ts"
    },
    "./management": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:execution": "tsx watch src/execution/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:execution": "vitest src/execution",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "clean:logs": "node -e \"const fs=require('fs');try{fs.rmSync('logs',{recursive:true,force:true});fs.mkdirSync('logs',{recursive:true})}catch{}\"",
    "clean:data": "node -e \"const fs=require('fs');['data/results','logs','analysis/output'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch{}});['logs'].forEach(d=>{try{fs.mkdirSync(d,{recursive:true})}catch{}})\"",
    "prepare": "npm run build",
    "cli": "tsx src/cli.ts",
    "demo": "tsx demo/server/index.ts",
    "demo:server": "tsx demo/server/index.ts",
    "demo:enumerate": "tsx demo/scripts/enumerate-devices.ts",
    "demo:enumerate:setup": "tsx demo/scripts/enumerate-devices.ts --setup-reverse --capabilities",
    "demo:iphone-webview": "tsx demo/scripts/run-iphone-webview.ts",
    "demo:galadriel-iphone": "tsx demo/scripts/run-galadriel-iphone.ts",
    "automation": "tsx src/cli/automation.ts",
    "analysis": "npm run analysis:setup && npm run analysis:jupyter",
    "analysis:setup": "node analysis/setup-env.js",
    "analysis:setup:jupyter": "node analysis/setup-env.js --jupyter",
    "analysis:jupyter": "node analysis/launch-jupyter.js",
    "analysis:jupyter:lab": "node analysis/launch-jupyter.js --lab"
  },
  "keywords": [
    "testing",
    "automation",
    "adb",
    "puppeteer",
    "device-farm",
    "distributed-testing",
    "gamification",
    "citizen-science",
    "iot",
    "android",
    "ios",
    "browser-automation",
    "cross-platform",
    "utopia"
  ],
  "author": "UTOP.IA Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/utopia/auto-mat-ion"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/websocket": "^8.3.1",
    "adbkit": "^2.11.1",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.3",
    "eventemitter3": "^5.0.1",
    "fastify": "^4.25.0",
    "ioredis": "^5.3.2",
    "nanoid": "^5.0.4",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "puppeteer-core": "^21.11.0",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "appium": "^2.4.1",
    "webdriverio": "^8.46.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "@vitest/coverage-v8": "^1.1.3",
    "appium-xcuitest-driver": "^7.25.0",
    "drizzle-kit": "^0.20.10",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.3"
  },
  "peerDependencies": {
    "puppeteer": ">=21.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  }
}
