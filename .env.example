# auto-mat-ion Configuration
# Copy this file to .env and adjust values

# App
NODE_ENV=development
PORT=9090
HOST=0.0.0.0
LOG_LEVEL=info

# Database (via vital-core)
DATABASE_URL=postgresql://vital:vital_password@localhost:5432/vital_core

# Redis (via vital-core)
REDIS_URL=redis://localhost:6379/0

# vital-core integration
VITAL_CORE_URL=http://localhost:8888
VITAL_CORE_ENABLED=true

# ADB (Android Debug Bridge)
ADB_HOST=localhost
ADB_PORT=5037

# Antifraude
CONSENSUS_MIN_DEVICES=3
ANOMALY_DETECTION_THRESHOLD=0.85
DEVICE_FINGERPRINT_SALT=change-me-in-production

# EUDI Integration (opcional)
EUDI_SANDBOX_URL=
EUDI_CLIENT_ID=
EUDI_ENABLED=false

# Points Configuration
POINTS_TEST_BASIC=1
POINTS_TEST_SUITE=10
POINTS_DEVICE_24H=50
POINTS_BUG_FOUND=100
POINTS_UNIQUE_DEVICE=200
